  "components": {
    "schemas": {
      "AnswerRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "default": "voice"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "user_answer": {
            "type": "string",
            "title": "User Answer"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "phase": {
            "type": "string",
            "title": "Phase",
            "default": "warm_up_retrieval"
          },
          "subtopic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtopic"
          },
          "result": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "correct",
                  "partial",
                  "incorrect"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "mistake_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "recall",
                  "mechanism",
                  "prioritization",
                  "drug_dosing",
                  "monitoring",
                  "crisis_algorithm",
                  "oral_boards_framing",
                  "oral_presentation",
                  "incomplete_answer",
                  "overconfident_wrong",
                  "failure_to_escalate",
                  "differential_too_narrow",
                  "pretest_unstudied",
                  "critique_caught",
                  "critique_missed",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mistake Type"
          },
          "ideal_answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ideal Answer"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty",
            "default": "medium"
          },
          "hints_used": {
            "type": "integer",
            "title": "Hints Used",
            "default": 0
          },
          "confidence_reported": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence Reported"
          },
          "retrieval_sources": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval Sources"
          },
          "source_citations": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Citations"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "question",
          "user_answer",
          "topic"
        ],
        "title": "AnswerRequest"
      },
      "AnswerResponse": {
        "properties": {
          "evaluation": {
            "type": "string",
            "title": "Evaluation"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback"
          },
          "ideal_answer": {
            "type": "string",
            "title": "Ideal Answer"
          },
          "ideal_answer_key_points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ideal Answer Key Points"
          },
          "mistake_type": {
            "type": "string",
            "title": "Mistake Type"
          },
          "updated_mastery": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated Mastery"
          },
          "next_review_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Review Date"
          },
          "source_snippets": {
            "items": {
              "$ref": "#/components/schemas/SourceChunk"
            },
            "type": "array",
            "title": "Source Snippets"
          },
          "next_question": {
            "type": "string",
            "title": "Next Question"
          },
          "mini_teach": {
            "type": "string",
            "title": "Mini Teach",
            "default": ""
          },
          "teachback_prompt": {
            "type": "string",
            "title": "Teachback Prompt",
            "default": ""
          },
          "citation": {
            "type": "string",
            "title": "Citation",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "evaluation",
          "feedback",
          "ideal_answer",
          "mistake_type",
          "next_question"
        ],
        "title": "AnswerResponse"
      },
      "CA1CoverageResponse": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "default": "Stanford CA-1"
          },
          "granularity": {
            "type": "string",
            "title": "Granularity",
            "default": "fact"
          },
          "total_topics": {
            "type": "integer",
            "title": "Total Topics",
            "default": 0
          },
          "total_facts": {
            "type": "integer",
            "title": "Total Facts",
            "default": 0
          },
          "covered_topics": {
            "type": "integer",
            "title": "Covered Topics",
            "default": 0
          },
          "remaining_topics": {
            "type": "integer",
            "title": "Remaining Topics",
            "default": 0
          },
          "covered_facts": {
            "type": "integer",
            "title": "Covered Facts",
            "default": 0
          },
          "remaining_facts": {
            "type": "integer",
            "title": "Remaining Facts",
            "default": 0
          },
          "coverage_percent": {
            "type": "number",
            "title": "Coverage Percent",
            "default": 0.0
          },
          "next_targets": {
            "items": {
              "$ref": "#/components/schemas/CoverageTarget"
            },
            "type": "array",
            "title": "Next Targets"
          },
          "targets": {
            "items": {
              "$ref": "#/components/schemas/CoverageTarget"
            },
            "type": "array",
            "title": "Targets"
          }
        },
        "type": "object",
        "title": "CA1CoverageResponse"
      },
      "CasePrepRequest": {
        "properties": {
          "case_stem": {
            "type": "string",
            "title": "Case Stem"
          },
          "duration_minutes": {
            "type": "integer",
            "title": "Duration Minutes",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "case_stem"
        ],
        "title": "CasePrepRequest"
      },
      "CasePrepResponse": {
        "properties": {
          "case_stem": {
            "type": "string",
            "title": "Case Stem"
          },
          "review_topics": {
            "items": {
              "$ref": "#/components/schemas/CasePrepTopic"
            },
            "type": "array",
            "title": "Review Topics"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "case_stem",
          "review_topics"
        ],
        "title": "CasePrepResponse"
      },
      "CasePrepTopic": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "why": {
            "type": "string",
            "title": "Why"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceChunk"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "topic",
          "why"
        ],
        "title": "CasePrepTopic"
      },
      "CoverageTarget": {
        "properties": {
          "target_id": {
            "type": "string",
            "title": "Target Id",
            "default": ""
          },
          "topic": {
            "type": "string",
            "title": "Topic",
            "default": ""
          },
          "subtopic": {
            "type": "string",
            "title": "Subtopic",
            "default": ""
          },
          "fact": {
            "type": "string",
            "title": "Fact",
            "default": ""
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "new"
          },
          "mastery_score": {
            "type": "number",
            "title": "Mastery Score",
            "default": 0.0
          },
          "times_seen": {
            "type": "integer",
            "title": "Times Seen",
            "default": 0
          },
          "next_review_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Review Date"
          },
          "covered": {
            "type": "boolean",
            "title": "Covered",
            "default": false
          }
        },
        "type": "object",
        "title": "CoverageTarget"
      },
      "FollowUpAnswerSentence": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "book": {
            "type": "string",
            "title": "Book"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "matched_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Terms"
          }
        },
        "type": "object",
        "required": [
          "text",
          "book"
        ],
        "title": "FollowUpAnswerSentence"
      },
      "FollowUpRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "lesson_topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lesson Topic"
          },
          "mode_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode Hint"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "FollowUpRequest"
      },
      "FollowUpResponse": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "lesson_topic": {
            "type": "string",
            "title": "Lesson Topic",
            "default": ""
          },
          "queries_tried": {
            "items": {
              "type": "string"
